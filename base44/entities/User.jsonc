{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "gender": {
      "type": "string",
      "description": "Genere dell'atleta, usato per la sagoma corporea nella mappa posturale",
      "enum": [
        "maschio",
        "femmina"
      ]
    },
    "accent_color": {
      "type": "string",
      "title": "Colore tema",
      "description": "Colore accentato scelto dall'utente (canali HSL, es. '76 100% 58%'). Persistito anche in localStorage per uso offline."
    },
    "plan": {
      "type": "string",
      "title": "Piano di abbonamento",
      "description": "Piano attivo: freemium, pro o coach.",
      "enum": [
        "freemium",
        "pro",
        "coach"
      ],
      "default": "freemium"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}