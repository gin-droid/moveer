{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "gender": {
      "type": "string",
      "description": "Genere dell'atleta, usato per la sagoma corporea nella mappa posturale",
      "enum": [
        "maschio",
        "femmina"
      ]
    },
    "accent_color": {
      "type": "string",
      "title": "Colore tema",
      "description": "Colore accentato scelto dall'utente (canali HSL, es. '76 100% 58%'). Persistito anche in localStorage per uso offline."
    },
    "preferred_macro_categories": {
      "type": "array",
      "title": "Macro-categorie preferite",
      "description": "Macro-categorie selezionate durante l'onboarding. Usate per filtrare il catalogo esercizi mostrato all'utente.",
      "items": {
        "type": "string"
      }
    },
    "preferred_equipment": {
      "type": "array",
      "title": "Attrezzature preferite",
      "description": "Categorie di attrezzatura selezionate durante l'onboarding. Usate per filtrare il catalogo esercizi mostrato all'utente.",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "type": "string",
      "title": "Piano di abbonamento",
      "description": "Piano attivo: freemium, pro o coach.",
      "enum": [
        "freemium",
        "pro",
        "coach"
      ],
      "default": "freemium"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo personale",
      "format": "url",
      "description": "URL del logo caricato dall'utente (piano Pro o Coach). Mostrato nei report e nei PDF esportati."
    },
    "blocked": {
      "type": "boolean",
      "title": "Account bloccato",
      "description": "Se true, l'utente non pu\u00f2 accedere all'app. Impostabile solo dagli amministratori.",
      "default": false
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}